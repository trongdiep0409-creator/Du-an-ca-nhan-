# Titan OS Web V1 — Environment Variables
# ⚠️  NEVER commit .env.local or any file containing real secrets.
# Copy template values and fill with your own credentials.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/titan_os?schema=public

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
