generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 1: single-user — không có multi-user logic
  skills          Skill[]
  missions        Mission[]
  projects        Project[]
  evidence        Evidence[]
  roadmap         Roadmap?
  reviews         Review[]
  aiMessages      AiMessage[]
  settings        Setting?
}

model Roadmap {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  milestones Milestone[]

  user User @relation(fields: [userId], references: [id])
}

model Milestone {
  id          String    @id @default(uuid())
  roadmapId   String
  monthIndex  Int
  title       String
  description String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id])
}

model Skill {
  id            String       @id @default(uuid())
  userId        String
  name          String
  category      String
  level         SkillLevel
  targetLevel   SkillLevel
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  missionLinks MissionSkill[]
  learning     LearningProgress?
}

enum SkillLevel {
  FUNDAMENTAL_AWARENESS
  NOVICE
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model LearningProgress {
  id              String   @id @default(uuid())
  skillId         String   @unique
  timeSpentMinutes Int
  evidenceIds     String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id])
}

model Mission {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String?
  status      MissionStatus
  priority    MissionPriority
  evidenceId  String?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  missionLinks MissionSkill[]
  evidence    Evidence?       @relation("MissionEvidence", fields: [evidenceId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  projectId   String?
}

enum MissionStatus {
  DRAFT
  TO_DO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  ARCHIVED
}

enum MissionPriority {
  LOW
  MEDIUM
  HIGH
}

model MissionSkill {
  missionId  String
  skillId    String
  isRequired Boolean @default(false)

  @@id([missionId, skillId])
  mission Mission @relation(fields: [missionId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  status      ProjectStatus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  missions  Mission[]
  evidence  Evidence[]
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

model Evidence {
  id          String      @id @default(uuid())
  userId      String
  type        EvidenceType
  title       String
  description String?
  url         String?
  fileKey     String?
  status      EvidenceStatus
  projectId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user       User      @relation(fields: [userId], references: [id])
  project    Project?  @relation(fields: [projectId], references: [id])
  missions   Mission[] @relation("MissionEvidence")
  reviews    Review[]
}

enum EvidenceType {
  LINK
  FILE
  SCREENSHOT
  CERTIFICATE
  CODE
  NOTE
}

enum EvidenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id          String       @id @default(uuid())
  userId      String
  evidenceId  String
  status      ReviewStatus
  comment     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  aiMessageId String? @unique

  user       User     @relation(fields: [userId], references: [id])
  evidence   Evidence @relation(fields: [evidenceId], references: [id])
  aiMessage  AiMessage? @relation(fields: [aiMessageId], references: [id])
}

enum ReviewStatus {
  PENDING
  PASSED
  FAILED
}

model AiMessage {
  id        String   @id @default(uuid())
  userId    String
  role      AiRole
  content   String
  createdAt DateTime @default(now())
  user   User    @relation(fields: [userId], references: [id])
  review Review?
}

enum AiRole {
  ASSISTANT
  USER
}

model Setting {
  id        String   @id @default(uuid())
  userId    String   @unique
  theme     Theme    @default(LIGHT)
  language  Language @default(VI)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum Theme {
  LIGHT
  DARK
}

enum Language {
  VI
  EN
}
