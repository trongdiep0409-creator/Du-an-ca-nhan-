/// Titan OS Web v1 — Prisma schema (Phase 2 foundation)
///
/// Phase 2 defines ONLY the PostgreSQL datasource + Prisma generator.
/// No business-domain models are declared here — those belong to Phase 3+
/// after a product-design review.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
